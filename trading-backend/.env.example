# Shared bearer token every API/websocket request must send.
TRADING_API_TOKEN=change-me-dev-token

# Fernet key used to encrypt MT5 account passwords at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRADING_ENCRYPTION_KEY=

TRADING_DATABASE_URL=sqlite:///./trading.db

# Comma-separated list of allowed frontend origins.
TRADING_CORS_ORIGINS=http://localhost:5173

# 1 = use the built-in MT5 simulator instead of the real MetaTrader5 package.
# Leave unset (or 0) on the Windows host that has real terminals installed —
# it also auto-falls-back to mock if the MetaTrader5 package can't be imported.
TRADING_MT5_MOCK=0

TRADING_TICK_POLL_INTERVAL=0.5
TRADING_MAX_LOT_HARD_CAP=50
TRADING_DEFAULT_DEVIATION=20
TRADING_DEFAULT_MAGIC=990099
